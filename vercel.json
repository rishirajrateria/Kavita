{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "ALLOW_PLACEHOLDER_CONTENT": "true"
    }
  },
  "env": {
    "ALLOW_PLACEHOLDER_CONTENT": "true"
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/analytics-rollup",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/seo-health",
      "schedule": "30 3 * * 1"
    }
  ]
}
