# Copy to .env (git-ignored). Everything is optional: with no database the site builds from the
# seed content in src/content/seed. Never prefix a secret with NEXT_PUBLIC_.

# --- Supabase ---------------------------------------------------------------------------------
# Direct Postgres URL (Supabase dashboard → Connect → Transaction pooler, port 6543).
# Used by Drizzle (app data layer), `pnpm db:migrate`, `pnpm db:seed`, `pnpm db:studio`.
SUPABASE_DB_URL=
# Browser-safe project URL and anon key (Auth / Storage / Realtime in later phases).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — route handlers and admin only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -------------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# --- Personal data ----------------------------------------------------------------------------
# 32 random bytes, base64 — encrypts client birth details at rest (`openssl rand -base64 32`).
BIRTH_DETAILS_ENCRYPTION_KEY=

# --- Payments (Phase 4) -----------------------------------------------------------------------
PAYMENTS_ENABLED=false

# --- IndexNow (CLAUDE.md §8) ------------------------------------------------------------------
# 8–128 alphanumeric characters (`openssl rand -hex 16`). Served at /<key>.txt; unset = no pings.
INDEXNOW_KEY=
# Bearer secret for POST /api/indexnow (the admin calls it after a publish). Server-only.
INDEXNOW_SUBMIT_SECRET=
